# ---------------------------------------------------------------------------
# DM News Network — environment template
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL. Remote hosts require TLS with certificate verification.
# Local hosts (localhost/127.0.0.1) connect without TLS.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# REQUIRED in production. Minimum 32 characters, high entropy.
#   openssl rand -base64 48
# The app refuses to start in production if this is missing, short, or weak.
AUTH_SECRET=

# REQUIRED in production. Canonical public origin used to build password-reset
# links. Never derived from the request Host/Origin header. Must be https.
SITE_URL=http://localhost:3000

# Optional: private database CA (PEM contents or a file path).
# DATABASE_CA_CERT=

# Optional: number of proxies appending to X-Forwarded-For.
# Defaults to 1 in production (Vercel), 0 otherwise. Set 0 if directly exposed.
# TRUSTED_PROXY_HOPS=1

# Optional: shared rate-limit store (Upstash Redis REST).
# Without it, limits apply per instance; login lockout is database-backed.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional one-time first-admin provisioning on an empty production database.
# Remove both after the first successful deploy.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional: extra allowlisted hosts for ad/analytics scripts and CSP.
# AD_SCRIPT_ALLOWLIST=
# CSP_EXTRA_SCRIPT_SRC=

# Session lifetime in seconds (default 28800 = 8 hours).
# SESSION_MAX_AGE_SECONDS=28800

# Supabase Storage for media uploads (optional).
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# Postgres pool size per instance (default 2 on serverless).
# PG_POOL_MAX=2

# Password-reset email delivery (optional). Without it the reset flow still
# works but never returns the token or link in an API response.
# RESEND_API_KEY=
# MAIL_FROM="DM News Network <newsroom@example.com>"

# Development only: show seeded demo accounts on the sign-in page.
# Demo accounts are never created in production.
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
